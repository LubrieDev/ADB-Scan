# ADB Scan – USB access to Android devices without running ADB as root.
# Installed by the adb-scan package. The vendor IDs are kept in sync with
# ANDROID_VENDOR_IDS in crates/core/src/usb.rs.
#
# After installing or changing this file:
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=usb --action=change

SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", MODE="0660", GROUP="plugdev", TAG+="uaccess"
